#!/bin/bash
# linuxrunner: manages the GitHub Actions runners on a Linux box that runs systemd, such as the
# PC's WSL distro `gh-runner`. Run as root, by the Admin (Linux) workflow (its runner is a root
# service here), or by hand. It ADOPTS runners already installed by GitHub's own svc.sh
# (units actions.runner.<scope>.<name>.service) and never re-registers them, so adopting takes
# no CI offline. `linuxrunner help` lists the commands.
set -euo pipefail

# WSL runs a `wsl -u root` session in a mount namespace of its own, while systemd and the runner services live in PID 1's: a
# tmpfs mounted from such a session is invisible to the runners. So a root command from there re-runs itself in PID 1's.
# nsenter -m resets the working directory, so the script goes by its absolute path, checked to exist over there first.
# (LINUXRUNNER_NS1, with LINUXRUNNER_NS_TEST=1, lets the tests stand in for PID 1's namespace.)
NS1=/proc/1/ns/mnt
[ "${LINUXRUNNER_NS_TEST:-}" != 1 ] || NS1=${LINUXRUNNER_NS1:-$NS1}
if { [ "$EUID" = 0 ] || [ "${LINUXRUNNER_NS_TEST:-}" = 1 ]; } && [ -z "${LINUXRUNNER_IN_NS:-}" ] && [ -r "$NS1" ] &&
  command -v nsenter >/dev/null 2>&1 && [ "$(readlink "$NS1")" != "$(readlink /proc/self/ns/mnt)" ]; then
  self=$(readlink -f -- "$0" 2>/dev/null || true)
  if [ -f "$self" ] && nsenter -t 1 -m -- test -f "$self"; then exec env LINUXRUNNER_IN_NS=1 nsenter -t 1 -m -- bash "$self" "$@"; fi
  echo "linuxrunner: warning: this script is not reachable by an absolute path in PID 1's mount namespace, so it runs in this session's" >&2
fi
unset LINUXRUNNER_IN_NS

HOME_DIR=/opt/git-runner
[ -z "${GIT_RUNNER_HOME:-}" ] || HOME_DIR=$GIT_RUNNER_HOME   # tests point it elsewhere
RUNNERS=$HOME_DIR/runners            # runners this tool installed (the admin runner, `add-runner`)
HOST_FILE=$HOME_DIR/host             # this box's name, e.g. wsl-1
CI_OFF=$HOME_DIR/ci-off              # present = CI runners are stopped and stay stopped
CORES_FILE=$HOME_DIR/max-cores       # N = CI jobs may use N cores; absent = all
CONF=$HOME_DIR/conf                  # NAME.limits per runner: `cores=N` / `ram=MB` lines
SYSTEMD_DIR=${SYSTEMD_DIR:-/etc/systemd/system}   # where the MemoryMax / CPUQuota drop-ins go
ETC_DIR=${ETC_DIR:-/etc}              # where install-docker writes apt and Docker config (tests point it elsewhere)
SLOTS_FILE=$HOME_DIR/slots           # `slots=N` / `threads=T` lines: the PC's job slots (absent = no slot cap)
SLOT_DIR_FILE=$HOME_DIR/slot-dir     # where the slot locks live (the follower points it at the Windows side)
FOLLOW_LAST=$HOME_DIR/follow-last    # the Windows state the follower last applied
FOLLOW_UNIT=win-runners-follow.service
LOCK_FILE=$HOME_DIR/lock             # held (flock) by every command that changes the runners, so two never run at once
MAINT_FILE=$HOME_DIR/maintenance    # `PID TIME` while `ramdisk` changes the runners: slot-sync must not restart them
RAMDISK_FILE=$HOME_DIR/ramdisk      # `ramdisk on` writes the size in MB here; add-runner reads it for new runners
PUSH_CONF=$HOME_DIR/dashboard-push.json   # {url, host}; absent = no health push (`push-setup`)
PUSH_TOKEN=$HOME_DIR/dashboard-push-token # the dashboard's token for this box, root only
PUSH_UNIT=linuxrunner-push.service
PUSH_EVERY=${PUSH_EVERY:-30}              # seconds between health pushes to the dashboard
CI_USER=${CI_USER:-runner}           # who adopted and new CI runners run as
UNIT_GLOB='actions.runner.*.service'

log() { printf '%s %s\n' "$(date '+%F %T')" "$*"; }
die() { log "error: $*" >&2; exit 1; }
need_root() { [ "$(id -u)" = 0 ] || die "run as root (sudo linuxrunner)"; }
# Runs a command that changes runners under the lock, held until this process exits. Only the command dispatch below takes it:
# the follower service calls cmd_slots and friends itself, in one long-lived process, and so never holds it; ramdisk-mount
# (each unit's ExecStartPre, run while `ramdisk on` holds the lock), the hooks and slot-sync never take it either.
locked() {
  mkdir -p "$HOME_DIR"
  exec 9>"$LOCK_FILE"
  flock -w "${LOCK_WAIT:-30}" 9 || die "another linuxrunner change is in progress: try again when it finishes (a ramdisk change waits for running jobs)"
  "$@"
}

# --- discovery ----------------------------------------------------------------------------

units() { systemctl list-units "$UNIT_GLOB" --all --plain --no-legend 2>/dev/null | awk '{print $1}'; }
unit_name() { local n=${1#actions.runner.}; n=${n%.service}; echo "${n#*.}"; }  # strip the scope
unit_for() { local u; for u in $(units); do [ "$(unit_name "$u")" = "$1" ] && { echo "$u"; return; }; done; return 1; }
unit_dir() { systemctl show -p WorkingDirectory --value "$1"; }
is_admin() { [[ "$1" == *-admin ]]; }
ci_units() { local u; for u in $(units); do is_admin "$(unit_name "$u")" || echo "$u"; done; }
host() { [ -f "$HOST_FILE" ] && cat "$HOST_FILE" || hostname; }
is_busy() { pgrep -f "$(unit_dir "$1")/bin/Runner.Worker" >/dev/null 2>&1; }
state() { systemctl is-active "$1" 2>/dev/null || true; }
runner_field() {  # DIR FIELD -> value from .runner (never prints tokens: only known fields)
  sed -nE "s|.*\"$2\"[[:space:]]*:[[:space:]]*\"([^\"]*)\".*|\1|p" "$1/.runner" | head -1
}

# --- commands -----------------------------------------------------------------------------

cmd_status() {
  local u d
  echo "host: $(host)  ($(. /etc/os-release && echo "$PRETTY_NAME"), $(nproc) cores, $(free -m | awk '/Mem:/{print $2}') MB RAM)"
  [ -f "$CI_OFF" ] && echo "CI: off (linuxrunner ci on to resume)" || echo "CI: on"
  [ -f "$CORES_FILE" ] && echo "max cores: $(cat "$CORES_FILE")" || echo "max cores: all"
  [ -s "$RAMDISK_FILE" ] && echo "RAM workspace: on ($(cat "$RAMDISK_FILE") MB per runner)" || echo "RAM workspace: off"
  if [ -n "$(slots_n)" ]; then
    echo "slots: $(held_slots | wc -l) of $(slots_n) in use on the PC ($(slots_threads) threads each)"
    for u in $(held_slots); do echo "  $(basename "$u"): $(owner_field "$u" runner) ($(owner_field "$u" side))"; done
  else echo "slots: off"; fi
  for u in $(units); do
    d=$(unit_dir "$u")
    printf '  %-28s %-9s %s %s\n' "$(unit_name "$u")" "$(state "$u")" \
      "$(is_busy "$u" && echo busy || echo idle)" "$(runner_field "$d" gitHubUrl)"
  done
}

cmd_doctor() {
  local bad=0 u d
  cmd_status
  echo "-- checks"
  [ "$(systemctl is-system-running 2>/dev/null || true)" != offline ] || { echo "FAIL systemd is not running"; bad=1; }
  for u in $(units); do
    d=$(unit_dir "$u")
    [ -f "$d/.runner" ] || { echo "FAIL $(unit_name "$u"): no .runner in $d"; bad=1; }
    if [ ! -f "$CI_OFF" ] && ! is_admin "$(unit_name "$u")" && [ "$(state "$u")" != active ]; then
      echo "FAIL $(unit_name "$u") is $(state "$u")"; bad=1
    fi
    [ "$(pgrep -fc "$d/bin/Runner.Listener" || true)" -le 1 ] || { echo "FAIL $(unit_name "$u"): two Runner.Listener processes"; bad=1; }
  done
  [ -n "$(ci_units)" ] || { echo "FAIL no CI runners found"; bad=1; }
  [ "$(df --output=pcent / | tail -1 | tr -dc 0-9)" -lt 90 ] || { echo "FAIL disk over 90% full"; bad=1; }
  [ "$bad" = 0 ] && echo "all checks passed"
  return "$bad"
}

jstr() { python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$1"; }
cmd_info() {
  local u d first=1
  local ram_mb
  ram_mb=$(free -m | awk '/Mem:/{print $2}')
  printf '{"host":%s,"kind":"linux","platform":"linux","cores":%s,"ram_mb":%s,"memory_gb":%s,"ci_on":%s,"max_cores":%s,"slots":%s,"slot_threads":%s,"slots_held":%s,"runners":[' \
    "$(jstr "$(host)")" "$(nproc)" "$ram_mb" "$(( (ram_mb + 512) / 1024 ))" \
    "$([ -f "$CI_OFF" ] && echo false || echo true)" "$([ -f "$CORES_FILE" ] && cat "$CORES_FILE" || echo null)" \
    "$(slots_n | grep . || echo null)" "$(slots_threads | grep . || echo null)" "$(held_slots | wc -l)"
  for u in $(units); do
    d=$(unit_dir "$u")
    [ "$first" = 1 ] || printf ','; first=0
    local n lc lr; n=$(unit_name "$u")
    lc=$(runner_limit "$n" cores); lr=$(runner_limit "$n" ram)
    printf '{"name":%s,"kind":"%s","state":%s,"busy":%s,"url":%s,"limit":{"cores":%s,"ram_mb":%s}}' "$(jstr "$n")" \
      "$(is_admin "$n" && echo admin || echo ci)" "$(jstr "$(state "$u")")" \
      "$(is_busy "$u" && echo true || echo false)" "$(jstr "$(runner_field "$d" gitHubUrl)")" "${lc:-null}" "${lr:-null}"
  done
  echo ']}'
}

# --- health push to the dashboard ---------------------------------------------------------
# The box reports its own `info` JSON to POST <url>/api/push-info with a bearer token, so the dashboard
# reads it straight from the box (over the tailnet, a LAN or any HTTPS address) instead of asking GitHub.
# Off unless `push-setup` wrote $PUSH_CONF. The token is only ever read from $PUSH_TOKEN and handed to curl
# through a private config file: never logged, never on a command line.

push_once() {  # -> prints the HTTP status; non-zero when nothing could be sent
  [ -f "$PUSH_CONF" ] && [ -f "$PUSH_TOKEN" ] || { echo "push is not set up here: run linuxrunner push-setup URL TOKENFILE" >&2; return 2; }
  local url
  url=$(sed -nE 's|.*"url"[[:space:]]*:[[:space:]]*"([^"]*)".*|\1|p' "$PUSH_CONF" | head -1)
  [ -n "$url" ] || { echo "push config has no url" >&2; return 2; }
  (  # a subshell, so the private config file is removed however it ends
    local cfg code
    cfg=$(mktemp)   # mktemp makes it 0600
    trap 'rm -f "$cfg"' EXIT
    printf 'header = "Authorization: Bearer %s"\n' "$(tr -d '\r\n ' < "$PUSH_TOKEN")" > "$cfg"
    code=$(cmd_info | curl -sS -o /dev/null -w '%{http_code}' --max-time 5 -K "$cfg" \
      -H 'Content-Type: application/json' --data-binary @- "$url") || exit 1
    echo "$code"
    [ "$code" = 200 ]
  )
}

cmd_push() { push_once >/dev/null || return 1; }

cmd_push_loop() {
  local failing=0 code
  while :; do
    if code=$(push_once 2>&1); then
      [ "$failing" = 0 ] || log "dashboard push works again"
      failing=0
    elif [ "$failing" = 0 ]; then
      log "dashboard push failed (${code:-no answer}); retrying every ${PUSH_EVERY}s"; failing=1
    fi
    sleep "$PUSH_EVERY"
  done
}

cmd_push_setup() {  # URL TOKENFILE: store the dashboard address and this box's token, start the push service
  need_root
  local url=${1%/} tokfile=$2 hostname
  url=${url%/api/push-info}
  case $url in https://*|http://*) ;; *) die "URL must start with https:// (or http:// on a trusted network)" ;; esac
  [[ "$url" =~ ^https?://[A-Za-z0-9._:/@-]+$ ]] || die "URL has characters it should not (letters, digits and . _ : / - only)"
  [ -f "$tokfile" ] || die "token file $tokfile is missing"
  [[ "$(tr -d '\r\n ' < "$tokfile")" =~ ^[A-Za-z0-9._~+/=-]{20,200}$ ]] || die "token file $tokfile does not hold a 20-200 character token"
  hostname=$(host)
  [[ "$hostname" =~ ^wsl-[0-9]+$ ]] || die "the dashboard accepts pushes from wsl-N hosts only; name this box first: linuxrunner bootstrap wsl-1"
  mkdir -p "$HOME_DIR"
  (umask 077; tr -d '\r\n ' < "$tokfile" > "$PUSH_TOKEN.new") && mv "$PUSH_TOKEN.new" "$PUSH_TOKEN"
  printf '{"url":"%s/api/push-info","host":"%s"}\n' "$url" "$hostname" > "$PUSH_CONF"
  printf '[Unit]\nDescription=Report this box to the runner dashboard\nWants=network-online.target\nAfter=network-online.target\n[Service]\nEnvironment=GIT_RUNNER_HOME=%s\nExecStart=%s/linuxrunner push-loop\nRestart=always\nRestartSec=10\n[Install]\nWantedBy=multi-user.target\n' "$HOME_DIR" "$HOME_DIR" > "$SYSTEMD_DIR/$PUSH_UNIT"
  systemctl daemon-reload; systemctl enable "$PUSH_UNIT" >/dev/null 2>&1 || true; systemctl restart "$PUSH_UNIT"
  log "health push set up: $url/api/push-info as $hostname every ${PUSH_EVERY}s. Delete $tokfile now."
}

cmd_push_test() {
  local code
  code=$(push_once 2>&1) && { echo "push accepted (HTTP $code)"; return 0; }
  case $code in
    401) echo "the dashboard does not know this token: check this box's line in its push tokens, then restart the dashboard" ;;
    429) echo "too many pushes or bad tokens; wait a minute" ;;
    503) echo "the dashboard has no push tokens yet (empty push_tokens secret)" ;;
    *) echo "push failed: ${code:-no answer}" ;;
  esac
  return 1
}

cmd_logs() {  # [name] [lines]
  local name=${1:-} n=${2:-80} u
  if [ -z "$name" ] || [ "$name" = "$(host)" ]; then for u in $(units); do echo "== $(unit_name "$u")"; journalctl -u "$u" -n 20 --no-pager; done; return; fi
  u=$(unit_for "$name") || die "no runner named $name"
  journalctl -u "$u" -n "$n" --no-pager
  ls -t "$(unit_dir "$u")"/_diag/Runner_*.log 2>/dev/null | head -1 | xargs -r tail -n 20
}

cmd_restart() {  # [name]: restarts CI runners, waiting out a running job for each
  local u
  for u in $( [ -n "${1:-}" ] && [ "${1:-}" != "$(host)" ] && unit_for "$1" || ci_units ); do
    is_busy "$u" && { log "$(unit_name "$u") is busy: skipped"; continue; }
    systemctl restart "$u"; log "restarted $(unit_name "$u")"
  done
}

# Stops the CI runners that have no job right now; one in a job is left to finish it (stopping it would cut the job
# short), and the next pass (the follower runs one every 2 s) stops it the moment the job ends.
ci_stop_idle() {
  local u
  for u in $(ci_units); do
    is_busy "$u" || [ "$(state "$u")" != active ] || { systemctl stop "$u" && log "CI off: stopped $(unit_name "$u")"; }
  done
}

cmd_ci() {  # on|off: off stops idle runners now and busy ones when their job ends, then stays off across reboots
  local u
  case "${1:-}" in
    off) need_root; : > "$CI_OFF"
      for u in $(ci_units); do systemctl disable "$u" 2>/dev/null; done
      ci_stop_idle; log "CI off" ;;
    on) need_root; rm -f "$CI_OFF"
      for u in $(ci_units); do systemctl enable --now "$u" 2>/dev/null; done; log "CI on" ;;
    *) die "ci on|off" ;;
  esac
}

# Per-runner limits (`limit`) win over the device-wide `cores`; a missing line = no per-runner limit.
runner_limit() {  # NAME cores|ram -> its own value, or nothing
  sed -n "s/^$2=\([0-9][0-9]*\)\$/\1/p" "$CONF/$1.limits" 2>/dev/null | head -1 || true
}
device_cores() { [ -f "$CORES_FILE" ] && cat "$CORES_FILE" || true; }

# --- job slots ------------------------------------------------------------------------------
# A PC allows at most N CI jobs at once across its Windows and Linux runners, each on T threads. The
# cap is N lock directories, slot-1..slot-N, in one folder both sides can see (on the PC, the Windows
# folder C:\ProgramData\win-runners-public\slots, here /mnt/c/...). A runner's job-started hook takes a
# slot with mkdir (atomic) and WAITS while all are taken; its job-completed hook gives it back. The
# slot number picks the job's block of T threads. `slot-sync` (the follower runs it every 2 s) clears
# slots whose job is gone and stops idle runners while every slot is held, so they take no more work.
slot_conf() { sed -n "s/^$1=\([0-9][0-9]*\)\$/\1/p" "$SLOTS_FILE" 2>/dev/null | head -1 || true; }
slots_n() { slot_conf slots; }
slots_threads() { slot_conf threads; }
slot_dir() {
  if [ -n "${SLOT_DIR:-}" ]; then echo "$SLOT_DIR"
  elif [ -s "$SLOT_DIR_FILE" ]; then cat "$SLOT_DIR_FILE"
  else echo "$HOME_DIR/slots.d"; fi
}
owner_field() { sed -n "s/^$2=//p" "$1/owner" 2>/dev/null | head -1 || true; }
held_slots() { local d; for d in "$(slot_dir)"/slot-*; do [ -d "$d" ] && echo "$d"; done; return 0; }
slot_age() { echo $(( $(date +%s) - $(stat -c %Y "$1" 2>/dev/null || date +%s) )); }

# The T threads of slot NUM (1-based): block NUM-1 of T CPUs, wrapping if the box has fewer CPUs.
cpu_block() {  # NUM THREADS TOTAL -> a CPU list such as 8-15, or nothing when the block is every CPU
  local num=$1 t=$2 total=$3 start end
  [ "$t" -lt "$total" ] || return 0
  start=$(( ((num - 1) * t) % total )); end=$(( start + t - 1 ))
  if [ "$end" -lt "$total" ]; then echo "$start-$end"; else echo "$start-$((total - 1)),0-$((end - total))"; fi
}

# --- RAM workspace: emptying it ------------------------------------------------------------
# `ramdisk on` gives every CI runner's work folder (GIT_RUNNER_WORK, from .runner's workFolder) a tmpfs. The job hooks keep
# it empty: nothing a job wrote may reach the next job, which may be another repo's. Everything under the work folder goes,
# the toolchain and action caches included, except `_temp` itself and the two runner-owned folders inside it, whose contents
# go too; anything that is a symlink or a plain file where a folder belongs is replaced. find never follows symlinks and
# stays on the workspace's filesystem (-xdev).
#   WIPE_SH takes WORKDIR and `list` (print the first leftover under each level, nothing deleted) or `wipe`.
# Only the job-completed hook wipes: by the time the job-started hook runs, the runner has already downloaded the job's actions
# into _actions and made its workspace, so a wipe there would break the job. Files a Docker action created as root cannot be
# deleted by the runner's user: the completed hook then marks the folder (.hook-waiting) and waits, the runner still busy with
# this job, while a root systemd path unit (`ramdisk on` installs it) wipes it. A crashed job's files go when the service
# next starts (ramdisk-mount empties the folder).
WIPE_SH='w=$1; mode=$2
run() { if [ "$mode" = list ]; then find "$@" -print -quit; else find "$@" -exec rm -rf -- {} +; fi; }
bad() { [ -L "$1" ] || { [ -e "$1" ] && [ ! -d "$1" ]; }; }
run "$w" -xdev -mindepth 1 -maxdepth 1 ! -name _temp ! -name .hook-waiting
if bad "$w/_temp"; then if [ "$mode" = list ]; then echo "$w/_temp"; else rm -rf -- "$w/_temp"; fi; fi
if [ "$mode" = wipe ] && [ ! -e "$w/_temp" ]; then mkdir -p "$w/_temp"; fi
if [ -d "$w/_temp" ] && [ ! -L "$w/_temp" ]; then
  run "$w/_temp" -xdev -mindepth 1 -maxdepth 1 ! -name _runner_file_commands ! -name _github_workflow
  for k in _runner_file_commands _github_workflow; do
    p="$w/_temp/$k"
    if bad "$p"; then if [ "$mode" = list ]; then echo "$p"; else rm -rf -- "$p"; mkdir -p "$p"; fi; fi
    if [ -d "$p" ] && [ ! -L "$p" ]; then run "$p" -xdev -mindepth 1; fi
  done
fi'

# Only ever touches a real directory that is a mount point of its own (never a work folder that is a symlink, or still on the
# disk because RAM mode is off).
work_is_ram() { [ -n "${1:-}" ] && [ -d "$1" ] && [ ! -L "$1" ] && mountpoint -q "$1"; }
work_junk() { work_is_ram "$1" && sh -c "$WIPE_SH" _ "$1" list || true; }

# As the runner's user: delete the job's files (read-only directories made writable first). Returns 0 either way: the caller
# checks work_junk.
wipe_work() {  # WORKDIR
  local w=${1:-}
  work_is_ram "$w" || return 0
  find "$w" -xdev -mindepth 1 -maxdepth 1 -type d -exec chmod -R u+rwX -- {} + 2>/dev/null || true
  sh -c "$WIPE_SH" _ "$w" wipe 2>/dev/null || true
  return 0
}

# As root (the sweep path unit, or slot-sync), only while a job's completed hook is waiting on a workspace its user could not clean.
# WORKDIR comes from the unit's root-owned drop-in, never from .runner (which a job can edit), and is checked again here: a
# real directory by its own canonical path, that is a tmpfs mount point of its own and not a system one.
wipe_work_root() {  # WORKDIR
  local w=${1:-} owner
  [[ "$w" =~ $RAM_PATH_RE ]] && [[ "$w" != *..* ]] || return 0
  case $w in /|/tmp|/dev/shm|/run|/dev|/proc|/sys) return 0 ;; esac
  work_is_ram "$w" && [ "$(realpath -e "$w" 2>/dev/null)" = "$w" ] || return 0
  [ "$(findmnt -no FSTYPE --mountpoint "$w" 2>/dev/null)" = tmpfs ] || return 0
  owner=$(stat -c %u:%g "$w")
  sh -c "$WIPE_SH" _ "$w" wipe 2>/dev/null || true
  chown -h "$owner" "$w/_temp" "$w/_temp/_runner_file_commands" "$w/_temp/_github_workflow" 2>/dev/null || true
  return 0
}

# The job-completed hook's part. Never fails the job (it has finished). Files its user cannot delete are left to the root sweep:
# the hook waits (the runner still busy, so no job starts meanwhile) until the sweep has run, which removes the marker, or
# RAMDISK_SWEEP_WAIT seconds; whatever is still there is logged and goes at the next service start.
wipe_after_job() {  # WORKDIR
  local w=${1:-} deadline
  if ! work_is_ram "$w"; then log "RAM workspace $w is not mounted: nothing to empty"; return 0; fi
  wipe_work "$w"
  [ -n "$(work_junk "$w")" ] || return 0
  : > "$w/.hook-waiting" 2>/dev/null || true
  log "RAM workspace $w holds files this user cannot delete (root-owned, from a Docker action?): waiting for the root sweep"
  deadline=$(( $(date +%s) + ${RAMDISK_SWEEP_WAIT:-90} ))
  while [ "$(date +%s)" -lt "$deadline" ]; do
    sleep "${RAMDISK_SWEEP_POLL:-0.5}"
    [ -e "$w/.hook-waiting" ] && continue
    if [ -z "$(work_junk "$w")" ]; then log "the root sweep cleaned $w"; else log "warning: the root sweep ran but files in $w remain; they go when the runner service next starts"; fi
    return 0
  done
  rm -f "$w/.hook-waiting"
  log "warning: files in $w could not be deleted and no root sweep came in ${RAMDISK_SWEEP_WAIT:-90}s (is runnerpool-ramdisk-sweep.path enabled?); they go when the runner service next starts"
  return 0
}

# The hook the runner runs when a job starts (acquire) or ends (release); never fails the job. It runs
# as the runner's own user, so it only needs to read the files above.
cmd_hook() {  # acquire|release
  local action=${1:-} name=${GIT_RUNNER_NAME:-${RUNNER_NAME:-}} dir n t i d cpus last=0
  dir=$(slot_dir); n=$(slots_n); t=$(slots_threads)
  if [ -n "$name" ] && [ -n "$n" ]; then
    for d in "$dir"/slot-*; do  # a runner runs one job at a time, so any slot it still holds is left over
      [ -d "$d" ] && [ "$(owner_field "$d" runner)" = "$name" ] && rm -rf "$d"
    done
  fi
  if [ "$action" = release ]; then   # the slot is back first, so waiting on the root sweep never holds one
    [ -z "${GIT_RUNNER_WORK:-}" ] || wipe_after_job "$GIT_RUNNER_WORK"   # RAM mode
    return 0
  fi
  [ -n "$name" ] || { log "slot hook: no runner name, skipped"; return 0; }
  [ -n "$n" ] || return 0
  mkdir -p "$dir" 2>/dev/null || true
  while :; do
    # N is read on every pass, so `runner slots` changes take effect at once: a raise lets a waiting job in, a
    # lowering keeps it out until the held slots (ALL slot-* folders, whatever their number) are fewer than N.
    n=$(slots_n); t=$(slots_threads)
    [ -n "$n" ] || return 0
    if [ "$(held_slots | wc -l)" -lt "$n" ]; then
      for i in $(seq 1 "$n"); do
        mkdir "$dir/slot-$i" 2>/dev/null || continue
        printf 'runner=%s\nside=linux\npid=%s\njob=%s\ntime=%s\nblock=%s\n' "$name" "$$" "${GITHUB_RUN_ID:-}" "$(date +%s)" "$((i - 1))" > "$dir/slot-$i/owner"
        if [ "$(held_slots | wc -l)" -gt "$n" ]; then  # two jobs, or a lowered N, won the same instant: back out and retry
          rm -rf "$dir/slot-$i"; sleep "0.$((RANDOM % 5 + 1))"; continue 2
        fi
        cpus=$(cpu_block "$i" "${t:-8}" "$(nproc)")
        [ -z "$cpus" ] || ! command -v taskset >/dev/null 2>&1 || taskset -a -pc "$cpus" "$PPID" >/dev/null 2>&1 || true
        log "got PC job slot $i of $n${cpus:+ (CPUs $cpus)}"
        return 0
      done
    fi
    if [ $(( $(date +%s) - last )) -ge 30 ]; then log "waiting for a PC job slot ($(held_slots | wc -l) of $n in use)"; last=$(date +%s); fi
    sleep "${SLOT_POLL:-3}"
  done
}

# Clears slots held by a Linux job that is gone (cancelled, crashed), then pauses or resumes idle CI runners.
cmd_slot_sync() {
  local n d dir u name held age side
  ramdisk_sweep   # before the early returns: it must run with slots off too
  n=$(slots_n); [ -n "$n" ] || return 0
  dir=$(slot_dir)
  for d in $(held_slots); do
    age=$(slot_age "$d"); side=$(owner_field "$d" side); name=$(owner_field "$d" runner)
    if [ -z "$side" ]; then [ "$age" -gt 60 ] && rm -rf "$d"; continue; fi  # written a moment ago, or abandoned
    [ "$side" = linux ] && [ "$age" -gt 20 ] || continue
    u=$(unit_for "$name" 2>/dev/null) || u=
    if [ -z "$u" ] || ! is_busy "$u"; then rm -rf "$d"; log "cleared stale slot $(basename "$d") ($name has no job)"; fi
  done
  if [ -f "$CI_OFF" ]; then ci_stop_idle; return 0; fi   # `ci off` wins over slots: busy runners stop as their job ends
  ! maint_live || return 0   # a `ramdisk` change has the runners stopped on purpose: no pausing or resuming meanwhile
  [ -e "$HOME_DIR/provisioned" ] || return 0
  held=$(held_slots | wc -l)
  for u in $(ci_units); do
    if [ "$held" -ge "$n" ]; then
      is_busy "$u" || [ "$(state "$u")" != active ] || { systemctl stop "$u" && log "slots full: paused $(unit_name "$u")"; }
    else
      [ "$(state "$u")" = active ] || { systemctl start "$u" && log "slot free: resumed $(unit_name "$u")"; }
    fi
  done
  : "$dir"
}

write_hook_scripts() {
  local hook
  mkdir -p "$HOME_DIR"
  for hook in start:acquire done:release; do
    printf '#!/bin/sh\n# Job hook (linuxrunner hook %s): waits for a PC job slot / gives it back, and empties the RAM workspace. Never fails the job.\n%s/linuxrunner hook %s || true\nexit 0\n' \
      "${hook#*:}" "$HOME_DIR" "${hook#*:}" > "$HOME_DIR/slot-${hook%%:*}.sh"
    chmod 755 "$HOME_DIR/slot-${hook%%:*}.sh"
  done
}

cmd_slots() {  # N [THREADS] | off
  need_root
  local v=${1:-} t=${2:-} total u
  total=$(nproc)
  if [ "$v" = off ]; then
    rm -f "$SLOTS_FILE"
  else
    [[ "$v" =~ ^[0-9]+$ ]] && [ "$v" -ge 1 ] && [ "$v" -le 32 ] || die "slots N [THREADS] | off (N is 1 to 32)"
    [ -n "$t" ] || { t=$(slots_threads); t=${t:-8}; [ "$t" -le "$total" ] || t=$total; }
    [[ "$t" =~ ^[0-9]+$ ]] && [ "$t" -ge 1 ] && [ "$t" -le "$total" ] || die "threads is 1 to $total"
    mkdir -p "$HOME_DIR"
    printf 'slots=%s\nthreads=%s\n' "$v" "$t" > "$SLOTS_FILE"; chmod 644 "$SLOTS_FILE"
    write_hook_scripts
    mkdir -p "$(slot_dir)"; chmod 777 "$(slot_dir)" 2>/dev/null || true
  fi
  for u in $(ci_units); do apply_limits "$u"; done
  write_docker_slice
  [ -n "$(slots_n)" ] || for u in $(ci_units); do [ -f "$CI_OFF" ] || [ "$(state "$u")" = active ] || systemctl start "$u" || true; done
  log "job slots: ${v}${t:+ ($t threads each)}"
}

# Writes unit U's limits: CI_MAX_CORES / CI_MAX_RAM_MB in the runner's .env (jobs see them; workflows
# pass CI_MAX_CORES to pytest -n, make -j), the slot hooks when slots are on, and a drop-in with
# MemoryMax and CPUQuota (a real cap on the whole service, jobs included). Restarts the runner when it
# is idle; a busy one picks it up when it next restarts.
apply_limits() {  # UNIT
  local u=$1 name d cores ram dropin slots threads quota=
  name=$(unit_name "$u"); d=$(unit_dir "$u")
  slots=$(slots_n); threads=$(slots_threads)
  cores=$(runner_limit "$name" cores); [ -n "$cores" ] || cores=$(device_cores)
  if [ -n "$slots" ]; then
    [ -n "$(runner_limit "$name" cores)" ] || { [ -z "$cores" ] || [ "$cores" -gt "$threads" ] && cores=$threads; }
    quota=$((threads * 100))
  fi
  ram=$(runner_limit "$name" ram)
  touch "$d/.env"; sed -i '/^CI_MAX_CORES=/d;/^CI_MAX_RAM_MB=/d;/^GIT_RUNNER_NAME=/d;/^GIT_RUNNER_WORK=/d' "$d/.env"
  # Only the slot hooks this tool wrote: another tool's hooks (the Mac's Linux VM sets its own) stay.
  sed -i "\\|^ACTIONS_RUNNER_HOOK_JOB_STARTED=$HOME_DIR/slot-start.sh\$|d;\\|^ACTIONS_RUNNER_HOOK_JOB_COMPLETED=$HOME_DIR/slot-done.sh\$|d" "$d/.env"
  [ -z "$cores" ] || echo "CI_MAX_CORES=$cores" >> "$d/.env"
  [ -z "$ram" ] || echo "CI_MAX_RAM_MB=$ram" >> "$d/.env"
  if [ -n "$slots" ] || [ -s "$RAMDISK_FILE" ]; then   # the hooks also wipe the RAM workspace after each job
    { echo "ACTIONS_RUNNER_HOOK_JOB_STARTED=$HOME_DIR/slot-start.sh"; echo "ACTIONS_RUNNER_HOOK_JOB_COMPLETED=$HOME_DIR/slot-done.sh"; echo "GIT_RUNNER_NAME=$name"; } >> "$d/.env"
    [ ! -s "$RAMDISK_FILE" ] || echo "GIT_RUNNER_WORK=$(ramdisk_unit_path "$u")" >> "$d/.env"
  fi
  dropin=$SYSTEMD_DIR/$u.d/limits.conf
  if [ -n "$ram" ] || [ -n "$quota" ]; then
    mkdir -p "$(dirname "$dropin")"
    { echo '[Service]'; [ -z "$ram" ] || echo "MemoryMax=${ram}M"; [ -z "$quota" ] || echo "CPUQuota=${quota}%"; } > "$dropin"
  else
    rm -f "$dropin"; rmdir "$(dirname "$dropin")" 2>/dev/null || true
  fi
  systemctl daemon-reload || log "daemon-reload failed: the caps for $name apply after the next reload"
  if [ -n "${APPLY_NO_RESTART:-}" ]; then return 0; fi   # the caller (ramdisk) restarts what it stopped itself
  if is_busy "$u"; then log "$name is busy: limits apply when it next restarts"; else systemctl restart "$u"; fi
}

cmd_cores() {  # N|all
  need_root
  local v=${1:-} u
  if [ "$v" = all ]; then rm -f "$CORES_FILE"; elif [[ "$v" =~ ^[1-9][0-9]*$ ]]; then echo "$v" > "$CORES_FILE"; else die "cores N|all"; fi
  for u in $(ci_units); do apply_limits "$u"; done
  write_docker_slice
  log "max cores: $v"
}

# limit NAME cores=<N|default> ram=<MB|default>: this runner's own limits; either may be left out
# (unchanged). default drops the override, so the device-wide `cores` (or nothing) applies again.
cmd_limit() {
  need_root
  local name=${1:-} u arg k v total mem_mb cores ram
  [ -n "$name" ] || die "limit NAME cores=<N|default> ram=<MB|default>"
  shift
  [ $# -gt 0 ] || die "limit NAME cores=<N|default> ram=<MB|default>"
  is_admin "$name" && die "$name is an admin runner: limits are for CI runners"
  u=$(unit_for "$name") || die "no runner named $name"
  total=$(nproc); mem_mb=$(free -m | awk '/Mem:/{print $2}')
  cores=$(runner_limit "$name" cores); ram=$(runner_limit "$name" ram)
  for arg in "$@"; do
    k=${arg%%=*}; v=${arg#*=}
    [ "$k" != "$arg" ] || die "bad argument $arg (cores=<N|default> ram=<MB|default>)"
    case $k in
      cores)
        if [ "$v" = default ]; then cores=
        elif [[ "$v" =~ ^[0-9]+$ ]] && [ "$v" -ge 1 ] && [ "$v" -le "$total" ]; then cores=$v
        else die "cores is 1 to $total, or default"; fi ;;
      ram)
        if [ "$v" = default ]; then ram=
        elif [[ "$v" =~ ^[0-9]+$ ]] && [ "$v" -ge 256 ] && [ "$v" -le "$mem_mb" ]; then ram=$v
        else die "ram is 256 to $mem_mb (MB), or default"; fi ;;
      *) die "unknown limit $k (cores, ram)" ;;
    esac
  done
  mkdir -p "$CONF"
  { [ -z "$cores" ] || echo "cores=$cores"; [ -z "$ram" ] || echo "ram=$ram"; } > "$CONF/$name.limits"
  [ -s "$CONF/$name.limits" ] || rm -f "$CONF/$name.limits"
  apply_limits "$u"
  log "$name: cores ${cores:-default}, ram ${ram:-default} MB (RAM: CI_MAX_RAM_MB plus a systemd MemoryMax cap)"
}

# The runner tarball for this CPU: x86-64 boxes (the PC's WSL) take x64, ARM64 ones (the Macs' Colima VMs) arm64.
runner_arch() { case $(uname -m) in aarch64|arm64) echo arm64 ;; *) echo x64 ;; esac; }

latest_version() { curl -fsSLI -o /dev/null -w '%{url_effective}' https://github.com/actions/runner/releases/latest | sed 's|.*/v||'; }

cmd_add_runner() {  # REPO|ORG NAME LABELS TOKEN [ci|root]
  need_root
  local scope=$1 name=$2 labels=$3 token=$4 as=${5:-ci} dir=$RUNNERS/$2 url v user
  [ "$token" != - ] || die "add-runner needs a registration token"
  [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] || die "bad runner name"
  url=https://github.com/$scope
  [ "$as" = root ] && user=root || user=$CI_USER
  id "$user" >/dev/null 2>&1 || useradd -m -s /bin/bash "$user"
  # A docker-labelled runner's user must be in the docker group before its service starts. Docker installed before this user
  # existed (the installer's order) did not add it, and jobs failed with "permission denied ... docker.sock".
  if [ "$user" != root ] && [[ ",$labels," == *,docker,* ]] && getent group docker >/dev/null 2>&1; then usermod -aG docker "$user"; fi
  mkdir -p "$dir"
  v=$(latest_version)
  curl -fsSL "https://github.com/actions/runner/releases/download/v$v/actions-runner-linux-$(runner_arch)-$v.tar.gz" | tar xz -C "$dir"
  [ ! -x "$dir/bin/installdependencies.sh" ] || "$dir/bin/installdependencies.sh" >/dev/null 2>&1 || log "installdependencies.sh failed (continuing)"
  chown -R "$user" "$dir"
  sudo -u "$user" env RUNNER_ALLOW_RUNASROOT=1 "$dir/config.sh" --unattended --replace --url "$url" --token "$token" \
    --name "$name" --labels "$labels" --work _work >/dev/null
  ( cd "$dir" && RUNNER_ALLOW_RUNASROOT=1 ./svc.sh install "$user" >/dev/null )
  # RAM workspace is on: any CI runner (whoever it runs as; never an admin one) gets its workspace mounted and the wipe hook
  # wired BEFORE it can take a job, so nothing is stopped or deleted under one.
  if ! is_admin "$name" && [ -s "$RAMDISK_FILE" ]; then
    u=$(unit_for "$name")
    ramdisk_apply_unit "$u" "$(cat "$RAMDISK_FILE")"
    APPLY_NO_RESTART=1 apply_limits "$u"
    write_sweep_units
  fi
  ( cd "$dir" && ./svc.sh start >/dev/null )
  log "added $name ($url, labels $labels)"
  [[ ",$labels," != *,docker,* ]] || command -v docker >/dev/null || cmd_install_docker   # the label promises Docker
}

# --- RAM workspace: mounting it ------------------------------------------------------------
# `ramdisk on [MB]` puts a tmpfs on every CI runner's work folder, so checkouts and test temp files live in RAM and never fill
# the disk. There is no fstab entry: each runner's unit gets `ExecStartPre=+ linuxrunner ramdisk-mount ...` (as root), which
# mounts the tmpfs and empties it on every start of the service, after a boot or a crash. That also means a job can never
# redirect the mount: the folder is refused when it is a symlink. The size is a CAP, not a reservation: tmpfs uses RAM only for
# what is written, and a full workspace fails the job (ENOSPC) instead of eating the distro's memory. With slots on, tmpfs
# pages count against the runner service's MemoryMax. The mount is nosuid,nodev: a job cannot mknod (debootstrap-style jobs).
RAM_PATH_RE='^/[A-Za-z0-9._/-]+$'

# The work folder of unit U: .runner's workFolder (default _work), relative to the runner's folder.
ramdisk_unit_path() {  # UNIT
  local d wf
  d=$(unit_dir "$1"); wf=$(runner_field "$d" workFolder); wf=${wf:-_work}
  case $wf in /*) echo "$wf" ;; *) echo "$d/$wf" ;; esac
}
ramdisk_unit_user() { local u; u=$(systemctl show -p User --value "$1" 2>/dev/null || true); echo "${u:-root}"; }

maint_live() {  # a `ramdisk` change is running (its PID is alive and the marker is not old); a stale marker is removed
  local pid t
  [ -f "$MAINT_FILE" ] || return 1
  read -r pid t < "$MAINT_FILE" || true
  if [ -n "${pid:-}" ] && kill -0 "$pid" 2>/dev/null && [ $(( $(date +%s) - ${t:-0} )) -lt $(( ${RAMDISK_WAIT:-900} + 300 )) ]; then return 0; fi
  rm -f "$MAINT_FILE"; return 1
}

# Root, run by the unit's ExecStartPre (and by `ramdisk on`): mount the tmpfs (or resize it) and empty it.
cmd_ramdisk_mount() {  # WORKDIR MB UID GID
  need_root
  local w=${1:-} mb=${2:-} uid=${3:-} gid=${4:-}
  [[ "$w" =~ $RAM_PATH_RE ]] && [[ "$w" != *..* ]] && [[ "$mb" =~ ^[0-9]+$ ]] && [[ "$uid" =~ ^[0-9]+$ ]] && [[ "$gid" =~ ^[0-9]+$ ]] || die "ramdisk-mount WORKDIR MB UID GID"
  [ -d "$w" ] && [ ! -L "$w" ] && [ "$(realpath -e "$w")" = "$w" ] || die "$w is not a real directory (a symlink, or under one?): refusing to mount over it"
  if mountpoint -q "$w"; then mount -o "remount,size=${mb}m" "$w"
  else
    find "$w" -xdev -mindepth 1 -delete   # mounting over a full folder only hides it: the disk space must really come back
    mount -t tmpfs -o "size=${mb}m,mode=0755,uid=$uid,gid=$gid,nosuid,nodev" tmpfs "$w"
  fi
  find "$w" -xdev -mindepth 1 -delete
}

ramdisk_dropin() { echo "$SYSTEMD_DIR/$1.d/ramdisk.conf"; }
ramdisk_unit_size() {  # UNIT -> its configured size in MB, or nothing
  sed -n 's/^# size=\([0-9][0-9]*\)$/\1/p' "$(ramdisk_dropin "$1")" 2>/dev/null | head -1 || true
}
# Already as requested (same size, mounted): nothing to stop or restart.
ramdisk_unit_done() {  # UNIT SIZE_MB|off
  local u=$1 want=$2 w
  w=$(ramdisk_unit_path "$u")
  if [ "$want" = off ]; then [ ! -f "$(ramdisk_dropin "$u")" ] && ! mountpoint -q "$w" 2>/dev/null
  else [ "$(ramdisk_unit_size "$u")" = "$want" ] && mountpoint -q "$w" 2>/dev/null; fi
}

ramdisk_apply_unit() {  # UNIT SIZE_MB: the unit is stopped (or about to start): mount now, and on every start
  local u=$1 mb=$2 d w user uid gid dropin
  d=$(unit_dir "$u"); w=$(ramdisk_unit_path "$u")
  [[ "$w" =~ $RAM_PATH_RE ]] || die "$(unit_name "$u"): the work folder path $w has characters this tool does not mount over"
  [[ "$w" != *..* ]] || die "$(unit_name "$u"): the work folder path $w has .. in it"
  [ ! -L "$w" ] || die "$(unit_name "$u"): $w is a symlink: refusing to mount over it"
  mkdir -p "$w"
  [ -d "$w" ] && [ ! -L "$w" ] && [ "$(realpath -e "$w")" = "$w" ] || die "$(unit_name "$u"): $w is not a real directory (a symlink, or under one?)"
  user=$(ramdisk_unit_user "$u"); uid=$(id -u "$user"); gid=$(id -g "$user")
  cmd_ramdisk_mount "$w" "$mb" "$uid" "$gid"
  dropin=$(ramdisk_dropin "$u")
  mkdir -p "$(dirname "$dropin")"
  printf '# size=%s\n[Service]\nExecStartPre=+%s/linuxrunner ramdisk-mount %s %s %s %s\nExecStartPost=+-/bin/systemctl --no-block try-restart %s.path\n' \
    "$mb" "$HOME_DIR" "$w" "$mb" "$uid" "$gid" "$SWEEP_UNIT" > "$dropin"
  systemctl daemon-reload || log "daemon-reload failed: the mount ordering for $(unit_name "$u") applies after the next reload"
  log "$(unit_name "$u"): workspace $w on a ${mb} MB RAM disk"
}
ramdisk_remove_unit() {  # UNIT: the unit is stopped
  local u=$1 w
  w=$(ramdisk_unit_path "$u")
  if mountpoint -q "$w" 2>/dev/null; then umount "$w" || die "$(unit_name "$u"): could not unmount $w (in use?): nothing else was changed, run ramdisk off again"; fi
  rm -f "$(ramdisk_dropin "$u")"; rmdir "$SYSTEMD_DIR/$u.d" 2>/dev/null || true
  systemctl daemon-reload || true
  log "$(unit_name "$u"): workspace back on the disk"
}

# The RAM work folder of unit U as `ramdisk on` recorded it in the unit's root-owned drop-in (nothing when RAM mode is off for it).
ramdisk_unit_ram_path() {  # UNIT
  sed -n 's/^ExecStartPre=+[^ ]* ramdisk-mount \([^ ]*\) .*/\1/p' "$(ramdisk_dropin "$1")" 2>/dev/null | head -1 || true
}

# Root (the sweep path unit, or slot-sync): wipe the workspaces whose completed job hook is waiting on files its user cannot
# delete. The marker is always removed, wiped or not (during a ramdisk change, or with RAM mode off), so the path unit never
# fires in a loop; the hook judges by what is left.
ramdisk_sweep() {
  local u w
  maint_live || true   # clears a marker its process left behind (killed), so slot-sync does not stay paused
  compgen -G "$SYSTEMD_DIR/*.d/ramdisk.conf" >/dev/null || return 0   # RAM mode is off everywhere: nothing to sweep
  for u in $(ci_units); do
    w=$(ramdisk_unit_ram_path "$u")
    [ -n "$w" ] && [ -e "$w/.hook-waiting" ] || continue
    if [ -s "$RAMDISK_FILE" ] && ! maint_live; then
      wipe_work_root "$w"
      log "$(unit_name "$u"): swept a workspace the runner's user could not clean"
    fi
    rm -rf -- "$w/.hook-waiting" 2>/dev/null || true
  done
  return 0
}

# A root path unit that runs `ramdisk-sweep` the moment a completed hook marks its workspace, so the sweep needs neither the
# follower service nor slots. Each runner's start re-arms it (ExecStartPost in the drop-in): its watch on a work folder goes
# stale when the tmpfs is mounted over it. Rewritten whenever runners are added or removed; removed with `ramdisk off`.
SWEEP_UNIT=runnerpool-ramdisk-sweep
write_sweep_units() {
  local u w paths=''
  for u in $(ci_units); do w=$(ramdisk_unit_ram_path "$u"); [ -z "$w" ] || paths="$paths$w/.hook-waiting "; done
  if [ -z "$paths" ]; then remove_sweep_units; return 0; fi
  mkdir -p "$SYSTEMD_DIR"
  { echo '[Unit]'; echo 'Description=runnerpool: wipe RAM workspaces a job left files in that its user cannot delete'
    echo '[Path]'; for w in $paths; do echo "PathExists=$w"; done; echo 'TriggerLimitIntervalSec=0'
    echo '[Install]'; echo 'WantedBy=multi-user.target'; } > "$SYSTEMD_DIR/$SWEEP_UNIT.path"
  printf '[Unit]\nDescription=runnerpool: RAM workspace sweep\nStartLimitIntervalSec=0\n[Service]\nType=oneshot\nExecStart=%s/linuxrunner ramdisk-sweep\n' "$HOME_DIR" > "$SYSTEMD_DIR/$SWEEP_UNIT.service"
  systemctl daemon-reload || true
  systemctl enable "$SWEEP_UNIT.path" >/dev/null 2>&1 || true
  systemctl restart "$SWEEP_UNIT.path" >/dev/null 2>&1 || log "could not start $SWEEP_UNIT.path: root-owned files wait for the next service start"
}
remove_sweep_units() {
  systemctl disable --now "$SWEEP_UNIT.path" >/dev/null 2>&1 || true
  systemctl stop "$SWEEP_UNIT.service" >/dev/null 2>&1 || true
  rm -f "$SYSTEMD_DIR/$SWEEP_UNIT.path" "$SYSTEMD_DIR/$SWEEP_UNIT.service"
  systemctl daemon-reload || true
}

# Stops every CI runner that has to change, without cutting a job short: an idle runner is stopped (after a second look, since
# a job can be assigned up to a second before its Worker shows), a busy one is watched every 0.1 s and stopped the moment its job ends,
# before it can pick up the next one. DRAINED lists what was stopped; MAINT_FILE (PID and time) keeps slot-sync from starting
# them again. Gives up after RAMDISK_WAIT seconds (default 900, inside the Admin workflow's 20-minute limit), and then nothing
# was changed. The one window left is a job assigned in the instant between that second look and the stop (as with `ci off`).
ramdisk_drain() {  # UNITS...
  local deadline u left noted=0 pending=$*
  deadline=$(( $(date +%s) + ${RAMDISK_WAIT:-900} ))
  printf '%s %s\n' "$$" "$(date +%s)" > "$MAINT_FILE"
  while :; do
    left=
    for u in $pending; do
      [ "$(state "$u")" = active ] || continue
      if is_busy "$u"; then left="$left $u"
      else
        sleep "${RAMDISK_RECHECK:-1}"
        if is_busy "$u"; then left="$left $u"; else systemctl stop "$u"; DRAINED="$DRAINED $u"; fi
      fi
    done
    [ -n "$left" ] || return 0
    if [ "$(date +%s)" -ge "$deadline" ]; then
      die "a runner is still running a job after ${RAMDISK_WAIT:-900}s: nothing was changed (a busy queue can starve this; try again when CI is quieter)"
    fi
    [ "$noted" = 1 ] || { log "waiting for running jobs to finish:$left"; noted=1; }
    sleep "${RAMDISK_POLL:-0.1}"
    pending=$left
  done
}

# Runs on every exit of `ramdisk`, success or not (a failed mount, a cancelled workflow): lets slot-sync work again and starts
# the runners this change stopped, so a failure never strands them. A failed change is safe to run again.
ramdisk_finish() {
  local rc=$? u free=''
  rm -f "$MAINT_FILE"
  # With slots on, only as many as there are free slots: slot-sync resumes the rest when one frees, as it does any paused runner.
  [ -z "$(slots_n)" ] || free=$(( $(slots_n) - $(held_slots | wc -l) ))
  for u in $DRAINED; do
    if [ -f "$CI_OFF" ] || [ "$(state "$u")" = active ]; then continue; fi
    if [ -n "$free" ]; then [ "$free" -gt 0 ] || continue; free=$((free - 1)); fi
    systemctl start "$u" || true
  done
  # A failed `off` may have removed the sweep units while RAM mode is still on somewhere: put them back.
  if [ "$rc" != 0 ] && [ -s "$RAMDISK_FILE" ]; then write_sweep_units || true; fi
  [ "$rc" = 0 ] || log "ramdisk did not finish: the runners it stopped were started again; running it again completes it"
}

cmd_ramdisk() {  # on [MB] | off
  need_root
  local v=${1:-} mb=${2:-} mem_mb n u todo='' count=0
  DRAINED=
  mem_mb=$(free -m | awk '/Mem:/{print $2}')
  case $v in
    on)
      [ $# -le 2 ] || die "ramdisk on [MB] | off"
      if [ -z "$mb" ]; then   # half of one runner's share of RAM: the rest is for the job's own processes
        n=$(slots_n); [ -n "$n" ] || n=$(ci_units | wc -l); [ "$n" -ge 1 ] || n=1
        mb=$((mem_mb / n / 2)); [ "$mb" -ge 512 ] || mb=512
      fi
      [[ "$mb" =~ ^[0-9]{1,7}$ ]] || die "ramdisk on [MB]: 256 to $mem_mb"
      mb=$((10#$mb))   # 08 and 010 are decimal here, not octal
      [ "$mb" -ge 256 ] && [ "$mb" -le "$mem_mb" ] || die "ramdisk on [MB]: 256 to $mem_mb" ;;
    off) [ $# -eq 1 ] || die "ramdisk off takes no size"; mb=off ;;
    *) die "ramdisk on [MB] | off" ;;
  esac
  for u in $(ci_units); do ramdisk_unit_done "$u" "$mb" || { todo="$todo $u"; count=$((count + 1)); }; done
  [ "$mb" = off ] || [ $((mb * $(ci_units | wc -l))) -le "$mem_mb" ] || log "warning: $mb MB x $(ci_units | wc -l) runners is more than the $mem_mb MB of RAM: the caps add up to more than exists"
  trap ramdisk_finish EXIT
  trap 'exit 143' TERM INT HUP   # a cancelled workflow or a closed session still runs the EXIT cleanup
  # shellcheck disable=SC2086
  [ -z "$todo" ] || ramdisk_drain $todo
  [ "$mb" != off ] || remove_sweep_units   # first, so a sweep never holds a workspace that is being unmounted
  for u in $todo; do
    if [ "$mb" = off ]; then ramdisk_remove_unit "$u"; else ramdisk_apply_unit "$u" "$mb"; fi
  done
  # The setting is recorded only once every runner has it, so a failed change leaves the old one in force.
  if [ "$mb" = off ]; then rm -f "$RAMDISK_FILE"
  else mkdir -p "$HOME_DIR"; echo "$mb" > "$RAMDISK_FILE"; write_hook_scripts; write_sweep_units; fi
  APPLY_NO_RESTART=1   # a runner that was stopped (ci off, slots full) must stay stopped; ramdisk_finish restarts the drained ones
  for u in $(ci_units); do apply_limits "$u"; done
  [ "$count" -gt 0 ] && log "RAM workspace $mb: $count runner(s) changed" || log "RAM workspace already $mb on every runner"
  [ "$mb" = off ] || log "a CI runner adopted outside add-runner after this is picked up by the next ramdisk on"
}

# Docker's work runs in its own cgroups, outside the runner services' drop-ins, so a job's `docker build` would escape the
# slot caps. docker-ci.slice holds ONE slot's caps (threads x 100% CPU, RAM / slots) and dockerd, containerd and the
# containers all sit under it (install-docker wires that up). Slots off = the device-wide `cores` cap (CPU only; cores sets no
# RAM cap), or no cap when that is `all`. Rewritten by `slots` and `cores`; the caps apply live on daemon-reload (running containers are not restarted).
write_docker_slice() {
  local n t mem_mb f=$SYSTEMD_DIR/docker-ci.slice
  [ -f "$f" ] || [ -d "$SYSTEMD_DIR/docker.service.d" ] || return 0   # Docker is not set up here
  n=$(slots_n); t=$(slots_threads); mem_mb=$(free -m | awk '/Mem:/{print $2}')
  { echo '[Slice]'
    if [ -n "$n" ]; then echo "CPUQuota=$((t * 100))%"; echo "MemoryMax=$((mem_mb / n))M"
    elif [ -n "$(device_cores)" ]; then echo "CPUQuota=$(($(device_cores) * 100))%"; fi; } > "$f"
  systemctl daemon-reload || log "daemon-reload failed: the Docker slice caps apply after the next reload"
}

# Docker Engine from Docker's own apt repo, for the PC's WSL runners (label `docker`; the Mac VMs stay without it).
# Needs jq (the provisioning installs it).
# Safe to run again. Needs systemd (dockerd is the docker.service unit, enabled so it is up whenever the distro is).
cmd_install_docker() {
  need_root
  [ "$(runner_arch)" = x64 ] || die "Docker is only installed on x86-64 boxes (the PC's WSL), not on this ARM64 one"
  [ "$(systemctl is-system-running 2>/dev/null || true)" != offline ] || die "systemd is not running: dockerd would have no way to start"
  if [ -L /usr/bin/docker ] && [[ "$(readlink /usr/bin/docker)" == */docker-desktop/* ]]; then
    die "this distro uses Docker Desktop's WSL integration: switch it off for this distro (Docker Desktop > Settings > Resources > WSL integration)"
  fi
  local u user codename
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -qq
  apt-get install -y -qq ca-certificates curl >/dev/null
  mkdir -p "$ETC_DIR/apt/keyrings" "$ETC_DIR/apt/sources.list.d"
  curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o "$ETC_DIR/apt/keyrings/docker.asc"
  chmod a+r "$ETC_DIR/apt/keyrings/docker.asc"
  codename=$(. /etc/os-release && echo "${UBUNTU_CODENAME:-$VERSION_CODENAME}")
  echo "deb [arch=amd64 signed-by=$ETC_DIR/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $codename stable" > "$ETC_DIR/apt/sources.list.d/docker.list"
  apt-get update -qq
  apt-get install -y -qq docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin >/dev/null
  # Containers (cgroup-parent), dockerd and containerd (so BuildKit steps and anything else they start) go under docker-ci.slice.
  mkdir -p "$ETC_DIR/docker" "$SYSTEMD_DIR/docker.service.d" "$SYSTEMD_DIR/containerd.service.d"
  [ -s "$ETC_DIR/docker/daemon.json" ] || echo '{}' > "$ETC_DIR/docker/daemon.json"
  jq '. + {"cgroup-parent": "docker-ci.slice"}' "$ETC_DIR/docker/daemon.json" > "$ETC_DIR/docker/daemon.json.new"
  mv "$ETC_DIR/docker/daemon.json.new" "$ETC_DIR/docker/daemon.json"
  printf '[Service]\nSlice=docker-ci.slice\n' | tee "$SYSTEMD_DIR/docker.service.d/slice.conf" > "$SYSTEMD_DIR/containerd.service.d/slice.conf"
  write_docker_slice
  systemctl enable docker.service containerd.service
  systemctl restart containerd.service docker.service   # a running dockerd would keep its old cgroups (and containers stop)
  # Every CI runner's user may use the socket; a runner picks the group up when it restarts.
  for user in $CI_USER $(for u in $(ci_units); do systemctl show -p User --value "$u"; done); do
    ! id "$user" >/dev/null 2>&1 || usermod -aG docker "$user"
  done
  docker info >/dev/null
  log "Docker $(docker --version | sed 's/^Docker version //; s/,.*//') is installed and running"
  [ -f "$CI_OFF" ] || cmd_restart
}

cmd_remove_runner() {  # NAME [TOKEN|-]
  need_root
  local name=$1 token=${2:--} u d
  u=$(unit_for "$name") || die "no runner named $name"
  is_admin "$name" && die "refusing to remove an admin runner from here"
  d=$(unit_dir "$u")
  rm -f "$CONF/$name.limits"
  systemctl disable --now "$u"
  if mountpoint -q "$(ramdisk_unit_path "$u")" 2>/dev/null; then umount "$(ramdisk_unit_path "$u")" || log "could not unmount the RAM workspace of $name"; fi
  rm -rf "${SYSTEMD_DIR:?}/$u.d"
  [ ! -s "$RAMDISK_FILE" ] || write_sweep_units
  [ "$token" = - ] || sudo -u "$(stat -c %U "$d")" "$d/config.sh" remove --token "$token" >/dev/null
  rm -f "/etc/systemd/system/$u"; systemctl daemon-reload
  log "removed $name (its folder $d is left in place)"
}

cmd_install_admin() {  # REPO TOKEN [NAME]: the root runner the Admin (Linux) workflow runs on
  need_root
  local repo=$1 token=$2 name=${3:-$(host)-admin}
  mkdir -p "$HOME_DIR"
  [ -f "$HOST_FILE" ] || hostname > "$HOST_FILE"
  cmd_add_runner "$repo" "$name" "linux-admin,$(host)" "$token" root
}

# Follows the Windows side of a PC (the state file win/winrunner.ps1 writes): stops CI here when the PC
# is on battery or `runner ci win-1 off` was run, applies its core and slot settings, and keeps the job
# slots (slot-sync). One pass; the follower service repeats it every 2 seconds.
cmd_follow_once() {  # STATEFILE
  local f=$1 cur ci cores slots threads last=
  echo "$(dirname "$f")/slots" > "$SLOT_DIR_FILE"; chmod 644 "$SLOT_DIR_FILE"
  if [ -r "$f" ]; then
    cur=$(cat "$f"); [ ! -f "$FOLLOW_LAST" ] || last=$(cat "$FOLLOW_LAST")
    if [ "$cur" != "$last" ]; then
      ci=$(sed -n 's/^ci=//p' <<<"$cur"); cores=$(sed -n 's/^cores=//p' <<<"$cur")
      slots=$(sed -n 's/^slots=//p' <<<"$cur"); threads=$(sed -n 's/^threads=//p' <<<"$cur")
      # A box that is not provisioned (see win/linux-provision.sh) never turns CI on.
      [ -e "$HOME_DIR/provisioned" ] || ci=off
      if [ -n "$slots" ]; then
        if [ "$slots" = off ]; then cmd_slots off || true; else cmd_slots "$slots" ${threads:+"$threads"} || true; fi
      fi
      [ -z "$ci" ] || cmd_ci "$ci" || true
      [ -z "$cores" ] || cmd_cores "$cores" || true
      echo "$cur" > "$FOLLOW_LAST"
    fi
  fi
  cmd_slot_sync
}

cmd_follow() {  # STATEFILE
  while :; do cmd_follow_once "$1" || true; sleep "${FOLLOW_POLL:-2}"; done
}

cmd_install_follower() {  # [STATEFILE]: the service that runs `follow`; keeps the state file of the old one
  need_root
  local f=${1:-} unit=/etc/systemd/system/$FOLLOW_UNIT
  [ -n "$f" ] || f=$(sed -n 's|^ExecStart=[^ ]* \(follow \)\{0,1\}||p' "$unit" 2>/dev/null | head -1)
  [ -n "$f" ] || die "install-follower STATEFILE"
  printf '[Unit]\nDescription=Follow the Windows CI state\n[Service]\nExecStart=%s/linuxrunner follow %s\nRestart=always\n[Install]\nWantedBy=multi-user.target\n' "$HOME_DIR" "$f" > "$unit"
  rm -f "$FOLLOW_LAST"
  systemctl daemon-reload; systemctl enable "$FOLLOW_UNIT" >/dev/null 2>&1 || true; systemctl restart "$FOLLOW_UNIT"
  log "follower installed for $f"
}

cmd_self_update() {  # FILE
  need_root
  [ -s "$1" ] && bash -n "$1" || die "not a valid script: $1"
  install -m 755 "$1" "$HOME_DIR/linuxrunner"; ln -sf "$HOME_DIR/linuxrunner" /usr/local/bin/linuxrunner
  log "linuxrunner updated"
  # A follower from before slots existed ran a script of its own: move it onto this one.
  [ ! -f "/etc/systemd/system/$FOLLOW_UNIT" ] || "$HOME_DIR/linuxrunner" install-follower || log "could not update the follower"
}

cmd_bootstrap() {  # NAME: first-time setup on a box whose runners were installed by hand
  need_root
  mkdir -p "$HOME_DIR"; echo "${1:-$(hostname)}" > "$HOST_FILE"
  install -m 755 "$0" "$HOME_DIR/linuxrunner"; ln -sf "$HOME_DIR/linuxrunner" /usr/local/bin/linuxrunner
  log "host named $(host); adopted: $(for u in $(units); do unit_name "$u"; done | tr '\n' ' ')"
}

usage() {
  cat <<'USAGE'
linuxrunner: manage GitHub Actions runners on a systemd Linux box (adopts existing ones)

  bootstrap [NAME]                   name this box (wsl-1) and install the tool; adopts running runners
  status | doctor | info             state, checks, JSON for the dashboard
  logs [NAME] [LINES]                service log and runner diagnostics
  restart [NAME]                     restart idle CI runners (busy ones are skipped)
  ci on|off                          CI runners take jobs / finish their job and stay stopped
  cores N|all                        CI jobs may use N cores (CI_MAX_CORES)
  ramdisk on [MB] | off              each CI runner's work folder on a RAM disk (tmpfs, size is a cap; default half a runner's
                                     share of RAM), emptied after every job. Waits for running jobs, never cuts one short
  ramdisk-mount DIR MB UID GID       what each runner's service runs as root before it starts (mount and empty the RAM disk)
  ramdisk-sweep                      root: wipe workspaces a completed job hook is waiting on (runnerpool-ramdisk-sweep.path)
  limit NAME cores=<N|default> ram=<MB|default>
                                     one runner's own limits (CI_MAX_CORES, CI_MAX_RAM_MB, systemd MemoryMax);
                                     they win over `cores`; default = back to the device-wide setting
  slots N [THREADS] | off            the PC's job slots: at most N CI jobs at once (lock folders), each on THREADS
                                     CPUs (default 8). Hooks make a job wait for a free slot; slot-sync pauses idle runners
  slot-sync                          clear dead slots, pause idle runners while every slot is held, resume them after
  hook acquire|release               what a runner's job-started / job-completed hook runs
  follow STATEFILE | follow-once STATEFILE | install-follower [STATEFILE]
                                     follow the Windows side of a PC (the service `install-follower` makes)
  add-runner REPO|ORG NAME LABELS TOKEN [ci|root]
  remove-runner NAME [TOKEN|-]
  install-docker                     Docker Engine from Docker's apt repo (x86-64 only), dockerd enabled, runners' users in
                                     the docker group; add-runner does it when the labels include docker
  install-admin REPO TOKEN [NAME]    the root runner `runner` reaches this box through
  push-setup URL TOKENFILE           report this box's info to the dashboard every 30 s (wsl-N hosts); URL like
                                     https://runners.example.com or a tailnet address; TOKENFILE holds this box's token
  push-test                          send the info once and say what the dashboard answered
  self-update FILE
USAGE
}

cmd=${1:-help}; shift || true
case $cmd in
  status) cmd_status ;;
  doctor) cmd_doctor ;;
  info) cmd_info ;;
  logs) cmd_logs "$@" ;;
  restart) cmd_restart "$@" ;;
  ci) locked cmd_ci "$@" ;;
  cores) locked cmd_cores "$@" ;;
  limit) locked cmd_limit "$@" ;;
  ramdisk) locked cmd_ramdisk "$@" ;;
  ramdisk-mount) cmd_ramdisk_mount "$@" ;;
  ramdisk-sweep) need_root; ramdisk_sweep ;;
  add-runner) [ $# -ge 4 ] || die "add-runner REPO|ORG NAME LABELS TOKEN [ci|root]"; locked cmd_add_runner "$@" ;;
  remove-runner) [ $# -ge 1 ] || die "remove-runner NAME [TOKEN|-]"; locked cmd_remove_runner "$@" ;;
  install-docker) cmd_install_docker ;;
  install-admin) [ $# -ge 2 ] || die "install-admin REPO TOKEN [NAME]"; cmd_install_admin "$@" ;;
  slots) [ $# -ge 1 ] || die "slots N [THREADS] | off"; locked cmd_slots "$@" ;;
  slot-sync) cmd_slot_sync ;;
  push) cmd_push ;;
  push-loop) cmd_push_loop ;;
  push-setup) [ $# -eq 2 ] || die "push-setup URL TOKENFILE"; cmd_push_setup "$@" ;;
  push-test) cmd_push_test ;;
  hook) [ $# -eq 1 ] || die "hook acquire|release"; cmd_hook "$1" ;;
  follow) [ $# -eq 1 ] || die "follow STATEFILE"; cmd_follow "$1" ;;
  follow-once) [ $# -eq 1 ] || die "follow-once STATEFILE"; cmd_follow_once "$1" ;;
  install-follower) cmd_install_follower "$@" ;;
  bootstrap) cmd_bootstrap "$@" ;;
  self-update) [ $# -eq 1 ] || die "self-update FILE"; cmd_self_update "$1" ;;
  help|-h|--help) usage ;;
  *) usage; exit 2 ;;
esac
